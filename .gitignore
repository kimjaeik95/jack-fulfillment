# 의존성
node_modules/

# 빌드 산출물
dist/
build/
out/
.vite/

# 백엔드 (Java/Gradle)
target/
.gradle/
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar

# 로컬 DB 파일 · 덤프 (커밋하지 않는다)
backend/data/
*.dump
*.sql.gz

# 환경 변수 — 비밀값이 들어가므로 절대 커밋하지 않는다
.env
