# 의존성
node_modules/

# 빌드 산출물
dist/
build/
out/
.vite/

# 백엔드 (Java/Gradle)
# target/ 은 Maven 산출물이다. 이 프로젝트는 Gradle(build/)을 쓰므로 거의
# 쓰이지 않지만, 앞에 / 를 붙여 최상위로 못박아 둔다. / 가 없으면 어느 깊이의
# target 폴더든 걸려서 target 이라는 이름의 자바 패키지가 통째로 커밋에서
# 빠진다 — 실제로 common/upload/target 이 그렇게 사라졌다.
/target/
.gradle/
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar

# 로컬 DB 파일 · 덤프 (커밋하지 않는다)
backend/data/
*.dump
*.sql.gz

# 환경 변수 — 비밀값이 들어가므로 절대 커밋하지 않는다
.env
.env.local
.env.*.local
*.local

# 로그
*.log
npm-debug.log*
yarn-error.log*

# 에디터 / OS
.DS_Store
Thumbs.db
.idea/
*.swp

# Claude Code 로컬 세션 설정 (개인 환경 전용)
.claude/settings.local.json

# 요구사항 원본 (docx · xlsx)
# 내용에 민감정보는 없으나, 공개 저장소라 원본 배포는 별도 판단이 필요해 일단 제외한다.
# 커밋하기로 하면 이 세 줄을 지우면 된다. 평문 사본(docs/*.md)은 커밋된다.
docs/*.docx
docs/*.xlsx
