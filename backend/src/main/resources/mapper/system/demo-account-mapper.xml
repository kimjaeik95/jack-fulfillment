<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  로그인 화면의 데모 계정 (COM-PG-001).

  로그인 전에 나가는 질의라 <b>고르는 컬럼이 곧 보안 경계</b>다. 이메일 ·
  연락처 · 비밀번호 해시 · 로그인 실패 횟수는 고르지 않는다. 나중에 컬럼을
  더할 일이 있으면 "로그인하지 않은 사람이 봐도 되나" 를 먼저 묻는다.

  이 매퍼를 쓰는 컨트롤러는 local 프로파일에서만 등록된다.
-->
<mapper namespace="com.fulfillment.system.auth.demo.dao.DemoAccountDao">

    <resultMap id="demoAccountMap" type="com.fulfillment.system.auth.demo.DemoAccountRow">
        <result property="userId"    column="user_id"/>
        <result property="userName"  column="user_name"/>
        <result property="deptName"  column="dept_name"/>
        <result property="orgName"   column="org_name"/>
        <result property="roleIds"   column="role_ids"/>
        <result property="roleNames" column="role_names"/>
        <result property="status"    column="status"/>
        <result property="useYn"     column="use_yn"/>
    </resultMap>

    <!--
      역할을 쉼표로 묶어 한 번에 읽는다. 계정마다 역할을 따로 읽으면 계정 수만큼
      질의가 붙는데, 로그인 화면이 열릴 때마다 그럴 이유가 없다.

      정렬은 역할의 sort_order 를 먼저 본다. 화면이 '역할별 대표 1건' 으로
      추리므로, 같은 역할이 여럿이면 <b>먼저 오는 계정이 대표가 된다</b> —
      정렬이 흔들리면 어제 눌렀던 계정이 오늘은 목록에 없다.

      정지된 계정도 준다. 그 상태로 로그인했을 때 화면이 무엇을 말하는지가
      확인할 거리 중 하나다.
    -->
    <select id="selectDemoAccounts" resultMap="demoAccountMap">
        SELECT u.user_id,
               u.user_name,
               u.dept_name,
               o.org_name,
               r.role_ids,
               r.role_names,
               u.status,
               u.use_yn
          FROM tb_user u
          LEFT JOIN tb_org o ON o.org_seq = u.org_seq
          LEFT JOIN LATERAL (
               SELECT STRING_AGG(ro.role_id,   ',' ORDER BY ro.sort_order, ro.role_id) AS role_ids,
                      STRING_AGG(ro.role_name, ',' ORDER BY ro.sort_order, ro.role_id) AS role_names,
                      MIN(ro.sort_order) AS top_sort
                 FROM tb_user_role ur
                 JOIN tb_role ro ON ro.role_seq = ur.role_seq
                WHERE ur.user_seq = u.user_seq
          ) r ON TRUE
         ORDER BY COALESCE(r.top_sort, 9999), u.user_id
    </select>

</mapper>
