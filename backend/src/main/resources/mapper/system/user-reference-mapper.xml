<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  사용자 검증에 필요한 참조 조회.
  조직은 org-mapper 로 옮겼다. 역할 기능이 생기면 이 파일도 지운다.
-->
<mapper namespace="com.fulfillment.system.user.dao.UserReferenceDao">


    <select id="selectRolesByIds" resultType="com.fulfillment.domain.Role">
        SELECT role_seq, role_id, role_name, description,
               org_scope, default_data_scope, restriction_summary,
               sort_order, use_yn
          FROM tb_role
         WHERE role_id IN
        <foreach collection="roleIds" item="rid" open="(" separator="," close=")">
            #{rid}
        </foreach>
         ORDER BY sort_order
    </select>

</mapper>
