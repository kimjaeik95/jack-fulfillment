<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.fulfillment.common.doc.dao.DocNumberDao">

    <!--
      하루치 카운터를 올리고 올린 값을 돌려받는다.

      INSERT ... ON CONFLICT DO UPDATE ... RETURNING 은 한 문장이라, 읽고
      쓰는 사이에 다른 트랜잭션이 끼어들 틈이 없다. 같은 날 같은 종류로
      동시에 들어와도 두 요청은 서로 다른 번호를 받는다.

      EXCLUDED 를 쓰지 않고 tb_doc_number.last_seq + 1 로 적는 이유는,
      충돌한 쪽이 가져온 값(항상 1)이 아니라 이미 저장된 값에서 이어야
      하기 때문이다.
    -->
    <select id="nextSeq" resultType="int">
        INSERT INTO tb_doc_number (doc_type, doc_date, last_seq)
        VALUES (#{docType}, #{docDate}, 1)
        ON CONFLICT (doc_type, doc_date)
        DO UPDATE SET last_seq = tb_doc_number.last_seq + 1
        RETURNING last_seq
    </select>

</mapper>
