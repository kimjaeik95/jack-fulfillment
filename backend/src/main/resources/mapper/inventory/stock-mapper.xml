<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.fulfillment.inventory.stock.dao.StockDao">

    <resultMap id="stockMap" type="com.fulfillment.domain.Stock">
        <id     property="stockSeq"      column="stock_seq"/>
        <result property="locationSeq"   column="location_seq"/>
        <result property="skuSeq"        column="sku_seq"/>
        <result property="vendorSeq"     column="vendor_seq"/>
        <result property="qtyOnHand"     column="qty_on_hand"/>
        <result property="qtyAllocated"  column="qty_allocated"/>
        <result property="qtyUnsellable" column="qty_unsellable"/>
        <result property="qtyAvailable"  column="qty_available"/>
        <result property="lastCountedAt" column="last_counted_at"/>
        <result property="createdBy"     column="created_by"/>
        <result property="createdAt"     column="created_at"/>
        <result property="updatedBy"     column="updated_by"/>
        <result property="updatedAt"     column="updated_at"/>
        <result property="locationId"    column="location_id"/>
        <result property="warehouseId"   column="warehouse_id"/>
        <result property="warehouseName" column="warehouse_name"/>
        <result property="warehouseType" column="warehouse_type"/>
        <result property="plantId"       column="plant_id"/>
        <result property="plantName"     column="plant_name"/>
        <result property="orgSeq"        column="org_seq"/>
        <result property="skuId"         column="sku_id"/>
        <result property="colorCode"     column="color_code"/>
        <result property="sizeCode"      column="size_code"/>
        <result property="productId"     column="product_id"/>
        <result property="productName"   column="product_name"/>
        <result property="brandName"     column="brand_name"/>
        <result property="vendorId"      column="vendor_id"/>
        <result property="vendorName"    column="vendor_name"/>
    </resultMap>

    <resultMap id="historyMap" type="com.fulfillment.domain.StockHistory">
        <id     property="historySeq"  column="history_seq"/>
        <result property="stockSeq"    column="stock_seq"/>
        <result property="moveType"    column="move_type"/>
        <result property="qtyField"    column="qty_field"/>
        <result property="qtyDelta"    column="qty_delta"/>
        <result property="qtyBefore"   column="qty_before"/>
        <result property="qtyAfter"    column="qty_after"/>
        <result property="reasonCode"  column="reason_code"/>
        <result property="reasonGroup" column="reason_group"/>
        <result property="remark"      column="remark"/>
        <result property="refType"     column="ref_type"/>
        <result property="refNo"       column="ref_no"/>
        <result property="occurredAt"  column="occurred_at"/>
        <result property="createdBy"   column="created_by"/>
        <result property="locationId"  column="location_id"/>
        <result property="warehouseId" column="warehouse_id"/>
        <result property="plantId"     column="plant_id"/>
        <result property="plantName"   column="plant_name"/>
        <result property="orgSeq"      column="org_seq"/>
        <result property="skuId"       column="sku_id"/>
        <result property="productName" column="product_name"/>
        <result property="colorCode"   column="color_code"/>
        <result property="sizeCode"    column="size_code"/>
        <result property="reasonName"  column="reason_name"/>
    </resultMap>

    <resultMap id="allocMap" type="com.fulfillment.domain.StockAlloc">
        <id     property="allocSeq"          column="alloc_seq"/>
        <result property="stockSeq"          column="stock_seq"/>
        <result property="orderNo"           column="order_no"/>
        <result property="orderLineNo"       column="order_line_no"/>
        <result property="qtyAllocated"      column="qty_allocated"/>
        <result property="allocStatus"       column="alloc_status"/>
        <result property="allocatedAt"       column="allocated_at"/>
        <result property="qtyReleased"       column="qty_released"/>
        <result property="releaseReason"     column="release_reason"/>
        <result property="releasedAt"        column="released_at"/>
        <result property="createdBy"         column="created_by"/>
        <result property="createdAt"         column="created_at"/>
        <result property="updatedBy"         column="updated_by"/>
        <result property="updatedAt"         column="updated_at"/>
        <result property="locationId"        column="location_id"/>
        <result property="warehouseId"       column="warehouse_id"/>
        <result property="plantId"           column="plant_id"/>
        <result property="plantName"         column="plant_name"/>
        <result property="orgSeq"            column="org_seq"/>
        <result property="skuId"             column="sku_id"/>
        <result property="productName"       column="product_name"/>
        <result property="releaseReasonName" column="release_reason_name"/>
    </resultMap>


    <!--
      재고주소와 상품을 함께 읽는다.

      SKU 코드만으로는 무엇인지 알 수 없고, 빈코드만으로는 어느 센터인지
      알 수 없다 — 빈코드는 창고 안에서만 유일하다(V7). 재고를 읽을 때
      로케이션 → 창고 → 플랜트, SKU → 제품 → 브랜드를 항상 따라간다.
    -->
    <sql id="stockFrom">
        FROM tb_stock s
        JOIN tb_location  l  ON l.location_seq  = s.location_seq
        JOIN tb_warehouse w  ON w.warehouse_seq = l.warehouse_seq
        JOIN tb_plant     p  ON p.plant_seq     = w.plant_seq
        JOIN tb_sku       k  ON k.sku_seq       = s.sku_seq
        JOIN tb_product   pr ON pr.product_seq  = k.product_seq
        LEFT JOIN tb_brand   b  ON b.brand_seq     = pr.brand_seq
        LEFT JOIN tb_supplier v ON v.supplier_seq  = s.vendor_seq
    </sql>

    <sql id="stockColumns">
        s.stock_seq, s.location_seq, s.sku_seq, s.vendor_seq,
        s.qty_on_hand, s.qty_allocated, s.qty_unsellable, s.qty_available,
        s.last_counted_at, s.created_by, s.created_at, s.updated_by, s.updated_at,
        l.location_id   AS location_id,
        w.warehouse_id  AS warehouse_id,
        w.warehouse_name AS warehouse_name,
        w.warehouse_type AS warehouse_type,
        p.plant_id      AS plant_id,
        p.plant_name    AS plant_name,
        p.org_seq       AS org_seq,
        k.sku_id        AS sku_id,
        k.color_code    AS color_code,
        k.size_code     AS size_code,
        pr.product_id   AS product_id,
        pr.product_name AS product_name,
        b.brand_name    AS brand_name,
        v.supplier_id   AS vendor_id,
        v.supplier_name AS vendor_name
    </sql>

    <!--
      데이터 범위 (COM-PG-004, STK-001).

      재고는 조직을 직접 갖지 않는다. 로케이션 → 창고 → 플랜트 → 운영
      조직으로 거슬러 판정한다. scope 를 넣지 않고 조회하면
      ScopedSearch.getScope() 가 예외를 던진다.
    -->
    <sql id="scopeFilter">
        <if test="!scope.unrestricted">
            <choose>
                <when test="scope.hasNoOrg">
                    AND s.created_by = #{scope.ownerId}
                </when>
                <otherwise>
                    AND ( p.org_seq IN
                          <foreach collection="scope.orgSeqs" item="o" open="(" separator="," close=")">
                              #{o}
                          </foreach>
                          OR s.created_by = #{scope.ownerId} )
                </otherwise>
            </choose>
        </if>
    </sql>

    <sql id="stockWhere">
        <where>
            <include refid="scopeFilter"/>
            <if test="plantId != null and plantId != ''">
                AND p.plant_id = #{plantId}
            </if>
            <if test="warehouseId != null and warehouseId != ''">
                AND w.warehouse_id = #{warehouseId}
            </if>
            <if test="locationId != null and locationId != ''">
                AND l.location_id = #{locationId}
            </if>
            <if test="skuId != null and skuId != ''">
                AND k.sku_id = #{skuId}
            </if>
            <if test="productId != null and productId != ''">
                AND pr.product_id = #{productId}
            </if>
            <if test="vendorId != null and vendorId != ''">
                AND v.supplier_id = #{vendorId}
            </if>
            <if test='onHandOnly == "Y"'>
                AND s.qty_on_hand &gt; 0
            </if>
            <!-- 보유는 있는데 팔 수 없는 행. 재고가 있는 줄 알고 주문받으면 결품이 난다. -->
            <if test='lockedOnly == "Y"'>
                AND s.qty_on_hand &gt; 0 AND s.qty_available = 0
            </if>
            <if test='unsellableOnly == "Y"'>
                AND s.qty_unsellable &gt; 0
            </if>
            <if test='neverCountedOnly == "Y"'>
                AND s.last_counted_at IS NULL
            </if>
            <if test="keyword != null and keyword != ''">
                AND ( LOWER(k.sku_id)        LIKE '%' || LOWER(#{keyword}) || '%'
                   OR LOWER(k.barcode)       LIKE '%' || LOWER(#{keyword}) || '%'
                   OR LOWER(pr.product_name) LIKE '%' || LOWER(#{keyword}) || '%'
                   OR LOWER(l.location_id)   LIKE '%' || LOWER(#{keyword}) || '%'
                   OR LOWER(l.barcode)       LIKE '%' || LOWER(#{keyword}) || '%' )
            </if>
        </where>
    </sql>

    <select id="selectList" resultMap="stockMap">
        SELECT <include refid="stockColumns"/>
        <include refid="stockFrom"/>
        <include refid="stockWhere"/>
        <!-- ${} 치환 자리다. StockSearch 가 화이트리스트로 걸러 SQL 인젝션을 막는다. -->
         ORDER BY ${sortColumn} ${sortDirection}, s.stock_seq ASC
        <if test="size > 0">
            LIMIT #{size} OFFSET #{offset}
        </if>
    </select>

    <select id="countList" resultType="long">
        SELECT COUNT(*)
        <include refid="stockFrom"/>
        <include refid="stockWhere"/>
    </select>

    <!--
      화면 상단 합계.

      목록이 페이징되므로 현재 페이지만 더하면 전체가 아니다. 같은 조건으로
      한 번 더 집계한다. 행이 하나도 없으면 SUM 이 NULL 을 돌려주므로
      응답 DTO 가 0 으로 맞춘다.
    -->
    <select id="sumBySearch" resultMap="stockMap">
        SELECT SUM(s.qty_on_hand)     AS qty_on_hand,
               SUM(s.qty_allocated)   AS qty_allocated,
               SUM(s.qty_unsellable)  AS qty_unsellable,
               SUM(s.qty_available)   AS qty_available
        <include refid="stockFrom"/>
        <include refid="stockWhere"/>
    </select>

    <!--
      단건. 데이터 범위는 서비스가 플랜트의 조직으로 다시 확인한다 —
      목록에 안 보이는 재고도 순번을 알면 닿을 수 있기 때문이다.
    -->
    <select id="selectBySeq" resultMap="stockMap">
        SELECT <include refid="stockColumns"/>
        <include refid="stockFrom"/>
         WHERE s.stock_seq = #{stockSeq}
    </select>


    <!-- ================================================================ -->
    <!-- 재고이동 이력 (INV-PG-003)                                        -->
    <!-- ================================================================ -->

    <!--
      사유코드의 이름을 함께 읽는다.

      사유는 행마다 코드그룹이 다르다 — 조정이면 REASON_ADJUST, 판매불가면
      REASON_INSPECT 다. 그래서 그룹까지 조건에 넣어 조인한다. 그룹 없이
      코드만으로 조인하면 다른 그룹의 같은 코드가 붙는다(DAMAGED 는 반품에도
      검수불량에도 있다).
    -->
    <sql id="historyFrom">
        FROM tb_stock_history h
        JOIN tb_stock     s  ON s.stock_seq     = h.stock_seq
        JOIN tb_location  l  ON l.location_seq  = s.location_seq
        JOIN tb_warehouse w  ON w.warehouse_seq = l.warehouse_seq
        JOIN tb_plant     p  ON p.plant_seq     = w.plant_seq
        JOIN tb_sku       k  ON k.sku_seq       = s.sku_seq
        JOIN tb_product   pr ON pr.product_seq  = k.product_seq
        LEFT JOIN tb_code_group rg ON rg.code_group_id = h.reason_group
        LEFT JOIN tb_code       rc ON rc.code_group_seq = rg.code_group_seq
                                  AND rc.code_id        = h.reason_code
    </sql>

    <sql id="historyWhere">
        <where>
            <include refid="scopeFilter"/>
            <if test="stockSeq != null">
                AND h.stock_seq = #{stockSeq}
            </if>
            <if test="plantId != null and plantId != ''">
                AND p.plant_id = #{plantId}
            </if>
            <if test="warehouseId != null and warehouseId != ''">
                AND w.warehouse_id = #{warehouseId}
            </if>
            <if test="skuId != null and skuId != ''">
                AND k.sku_id = #{skuId}
            </if>
            <if test="moveType != null and moveType != ''">
                AND h.move_type = #{moveType}
            </if>
            <if test="qtyField != null and qtyField != ''">
                AND h.qty_field = #{qtyField}
            </if>
            <if test="refType != null and refType != ''">
                AND h.ref_type = #{refType}
            </if>
            <if test="refNo != null and refNo != ''">
                AND h.ref_no = #{refNo}
            </if>
            <if test="fromDate != null">
                AND h.occurred_at &gt;= #{fromDate}
            </if>
            <!-- 끝날은 그날 전체를 포함한다. 23:59:59 로 적으면 그날 마지막 1초가 빠진다. -->
            <if test="toDate != null">
                AND h.occurred_at &lt; (CAST(#{toDate} AS date) + INTERVAL '1 day')
            </if>
            <if test="keyword != null and keyword != ''">
                AND ( LOWER(k.sku_id)        LIKE '%' || LOWER(#{keyword}) || '%'
                   OR LOWER(pr.product_name) LIKE '%' || LOWER(#{keyword}) || '%'
                   OR LOWER(l.location_id)   LIKE '%' || LOWER(#{keyword}) || '%'
                   OR LOWER(h.ref_no)        LIKE '%' || LOWER(#{keyword}) || '%' )
            </if>
        </where>
    </sql>

    <select id="selectHistory" resultMap="historyMap">
        SELECT h.history_seq, h.stock_seq, h.move_type, h.qty_field,
               h.qty_delta, h.qty_before, h.qty_after,
               h.reason_code, h.reason_group, h.remark,
               h.ref_type, h.ref_no, h.occurred_at, h.created_by,
               l.location_id   AS location_id,
               w.warehouse_id  AS warehouse_id,
               p.plant_id      AS plant_id,
               p.plant_name    AS plant_name,
               p.org_seq       AS org_seq,
               k.sku_id        AS sku_id,
               k.color_code    AS color_code,
               k.size_code     AS size_code,
               pr.product_name AS product_name,
               rc.code_name    AS reason_name
        <include refid="historyFrom"/>
        <include refid="historyWhere"/>
        <!-- ${} 치환 자리다. StockHistorySearch 가 화이트리스트로 거른다. -->
         ORDER BY ${sortColumn} ${sortDirection}, h.history_seq DESC
        <if test="size > 0">
            LIMIT #{size} OFFSET #{offset}
        </if>
    </select>

    <select id="countHistory" resultType="long">
        SELECT COUNT(*)
        <include refid="historyFrom"/>
        <include refid="historyWhere"/>
    </select>


    <!-- ================================================================ -->
    <!-- 할당 이력 (INV-PG-004)                                            -->
    <!-- ================================================================ -->

    <sql id="allocFrom">
        FROM tb_stock_alloc a
        JOIN tb_stock     s  ON s.stock_seq     = a.stock_seq
        JOIN tb_location  l  ON l.location_seq  = s.location_seq
        JOIN tb_warehouse w  ON w.warehouse_seq = l.warehouse_seq
        JOIN tb_plant     p  ON p.plant_seq     = w.plant_seq
        JOIN tb_sku       k  ON k.sku_seq       = s.sku_seq
        JOIN tb_product   pr ON pr.product_seq  = k.product_seq
        <!-- 해제 사유는 취소 사유 그룹에서 온다 (ORD-008) -->
        LEFT JOIN tb_code_group rg ON rg.code_group_id = 'REASON_CANCEL'
        LEFT JOIN tb_code       rc ON rc.code_group_seq = rg.code_group_seq
                                  AND rc.code_id        = a.release_reason
    </sql>

    <sql id="allocWhere">
        <where>
            <include refid="scopeFilter"/>
            <if test="stockSeq != null">
                AND a.stock_seq = #{stockSeq}
            </if>
            <if test="plantId != null and plantId != ''">
                AND p.plant_id = #{plantId}
            </if>
            <if test="warehouseId != null and warehouseId != ''">
                AND w.warehouse_id = #{warehouseId}
            </if>
            <if test="skuId != null and skuId != ''">
                AND k.sku_id = #{skuId}
            </if>
            <if test="orderNo != null and orderNo != ''">
                AND a.order_no = #{orderNo}
            </if>
            <if test="allocStatus != null and allocStatus != ''">
                AND a.alloc_status = #{allocStatus}
            </if>
            <!-- 아직 잡혀 있는 것만 — 푼 것을 뺀 나머지가 남은 행 -->
            <if test='heldOnly == "Y"'>
                AND a.qty_allocated &gt; a.qty_released
            </if>
            <if test="fromDate != null">
                AND a.allocated_at &gt;= #{fromDate}
            </if>
            <if test="toDate != null">
                AND a.allocated_at &lt; (CAST(#{toDate} AS date) + INTERVAL '1 day')
            </if>
            <if test="keyword != null and keyword != ''">
                AND ( LOWER(k.sku_id)        LIKE '%' || LOWER(#{keyword}) || '%'
                   OR LOWER(pr.product_name) LIKE '%' || LOWER(#{keyword}) || '%'
                   OR LOWER(l.location_id)   LIKE '%' || LOWER(#{keyword}) || '%'
                   OR LOWER(a.order_no)      LIKE '%' || LOWER(#{keyword}) || '%' )
            </if>
        </where>
    </sql>

    <select id="selectAllocs" resultMap="allocMap">
        SELECT a.alloc_seq, a.stock_seq, a.order_no, a.order_line_no,
               a.qty_allocated, a.alloc_status, a.allocated_at,
               a.qty_released, a.release_reason, a.released_at,
               a.created_by, a.created_at, a.updated_by, a.updated_at,
               l.location_id   AS location_id,
               w.warehouse_id  AS warehouse_id,
               p.plant_id      AS plant_id,
               p.plant_name    AS plant_name,
               p.org_seq       AS org_seq,
               k.sku_id        AS sku_id,
               pr.product_name AS product_name,
               rc.code_name    AS release_reason_name
        <include refid="allocFrom"/>
        <include refid="allocWhere"/>
        <!-- ${} 치환 자리다. StockAllocSearch 가 화이트리스트로 거른다. -->
         ORDER BY ${sortColumn} ${sortDirection}, a.alloc_seq DESC
        <if test="size > 0">
            LIMIT #{size} OFFSET #{offset}
        </if>
    </select>

    <select id="countAllocs" resultType="long">
        SELECT COUNT(*)
        <include refid="allocFrom"/>
        <include refid="allocWhere"/>
    </select>


    <!-- ================================================================ -->
    <!-- 갱신 — StockLedger 전용                                           -->
    <!--                                                                   -->
    <!-- 이 아래의 문장은 StockLedger 만 부른다. 서비스가 직접 부르면       -->
    <!-- 수량만 바뀌고 이력이 빠진 경로가 생긴다 (P-02).                    -->
    <!-- ================================================================ -->

    <!--
      행을 잠그고 읽는다.

      FOR UPDATE 는 조인한 테이블까지 잠그려 들기 때문에 대상 테이블을
      명시한다(OF s). 빈 · SKU 같은 기준정보까지 잠그면 재고를 하나 고치는
      동안 그 빈을 쓰는 다른 작업이 모두 멈춘다.
    -->
    <select id="selectForUpdate" resultMap="stockMap">
        SELECT <include refid="stockColumns"/>
        <include refid="stockFrom"/>
         WHERE s.stock_seq = #{stockSeq}
           FOR UPDATE OF s
    </select>

    <!--
      로케이션 × SKU × 거래처.

      거래처가 NULL 인 경우를 = 로 비교하면 늘 거짓이라 자사 재고를 영영
      못 찾는다. tb_stock 의 유니크 인덱스를 둘로 나눈 것과 같은 이유다.
    -->
    <select id="selectByKey" resultMap="stockMap">
        SELECT <include refid="stockColumns"/>
        <include refid="stockFrom"/>
         WHERE s.location_seq = #{locationSeq}
           AND s.sku_seq      = #{skuSeq}
        <choose>
            <when test="vendorSeq != null">
           AND s.vendor_seq = #{vendorSeq}
            </when>
            <otherwise>
           AND s.vendor_seq IS NULL
            </otherwise>
        </choose>
    </select>

    <insert id="insert" parameterType="com.fulfillment.domain.Stock"
            useGeneratedKeys="true" keyProperty="stockSeq" keyColumn="stock_seq">
        INSERT INTO tb_stock (location_seq, sku_seq, vendor_seq,
                              qty_on_hand, qty_allocated, qty_unsellable, created_by)
        VALUES (#{locationSeq}, #{skuSeq}, #{vendorSeq},
                #{qtyOnHand}, #{qtyAllocated}, #{qtyUnsellable}, #{createdBy})
    </insert>

    <!--
      수량항목 이름이 컬럼명이라 바인딩할 수 없다. 그래서 세 갈래를 직접
      적는다 — ${} 로 컬럼명을 치환하면 그 자리가 곧 SQL 주입 경로가 된다.
      StockLedger 가 값을 미리 검사하지만, 그 검사를 지우면 바로 뚫리는
      구조를 남겨 두지 않는다.
    -->
    <update id="updateQty">
        UPDATE tb_stock
           SET
        <choose>
            <when test='qtyField == "ON_HAND"'>     qty_on_hand    = #{qtyAfter}</when>
            <when test='qtyField == "ALLOCATED"'>   qty_allocated  = #{qtyAfter}</when>
            <when test='qtyField == "UNSELLABLE"'>  qty_unsellable = #{qtyAfter}</when>
            <otherwise>
                <!-- 여기 오면 StockLedger 의 검사가 뚫린 것이다. 아무것도
                     바꾸지 않고 DB 가 문법 오류를 내게 둔다. -->
                qty_on_hand = NULL
            </otherwise>
        </choose>
             , updated_by = #{updatedBy}
             , updated_at = CURRENT_TIMESTAMP
         WHERE stock_seq = #{stockSeq}
    </update>

    <update id="updateLastCounted">
        UPDATE tb_stock
           SET last_counted_at = CURRENT_TIMESTAMP,
               updated_by      = #{updatedBy},
               updated_at      = CURRENT_TIMESTAMP
         WHERE stock_seq = #{stockSeq}
    </update>

    <insert id="insertHistory" parameterType="com.fulfillment.domain.StockHistory"
            useGeneratedKeys="true" keyProperty="historySeq" keyColumn="history_seq">
        INSERT INTO tb_stock_history
